# Docker Deployment Environment Variables
# Copy this file to .env before deploying with Docker Compose

# PostgreSQL Configuration
POSTGRES_DB=quenti
POSTGRES_USER=quenti
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Application Port
APP_PORT=3000

# Database URLs (automatically constructed from above, but can be overridden)
# DATABASE_URL=postgresql://quenti:your_secure_password_here@db:5432/quenti
# DIRECT_URL=postgresql://quenti:your_secure_password_here@db:5432/quenti

# Next Auth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Quenti encryption key
# Generate with: openssl rand -base64 24
QUENTI_ENCRYPTION_KEY=your_encryption_key_here

# Google OAuth
# Get from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (optional - for Resend)
# RESEND_API_KEY=
# EMAIL_SENDER=
# USE_RESEND_PREVIEWS=true

# Org domain blacklist bypass (useful for testing)
BYPASS_ORG_DOMAIN_BLACKLIST=true

# Metrics
METRICS_API_USER=localhost
METRICS_API_PASSWORD=password

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inngest
INNGEST_EVENT_KEY=local
